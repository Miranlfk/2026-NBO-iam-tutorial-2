# enterprise-agent (AI agent, port 8791). Copy to enterprise-agent.env and fill in.
# One variable per line, no inline comments; single-quote values containing $.

# --- Set by compose.yaml from ../.env (values here are ignored) -----------------------------------------------
# ASGARDEO_BASE_URL  identity provider base URL                         = ${ASGARDEO_BASE_URL}
# REDIRECT_URI       redirect_uri of the agent's own sign-in            = https://enterprise-agent.${APPS_DOMAIN}
# OBO_REDIRECT_URI   delegated (on-behalf-of) authorization callback    = https://enterprise-agent.${APPS_DOMAIN}/obo/callback
# APP_BASE_URL       webapp origin allowed by CORS on /obo/*            = https://enterprise.${APPS_DOMAIN}
# MCP_SERVER_URL     MCP endpoint                                       = http://enterprise-mcp:8001/mcp
# LLM_BASE_URL       chat-completions base URL                          = ${LLM_BASE_URL}
# LLM_TOKEN_URL      token endpoint for the LLM client credentials      = ${LLM_TOKEN_URL:-${ASGARDEO_BASE_URL}/oauth2/token}

# --- Set by the image (override only if needed) ----------------------------------------------------------------
# HOST=0.0.0.0
# AGENT_PORT=8791
# AGENT_LOG_FILE=off

# --- Root-organization application the agent signs in through (the webapp's application) ----------------------
CLIENT_ID=<client-id>
CLIENT_SECRET='<client-secret>'

# --- Agent identity (console: Agents) ---------------------------------------------------------------------------
AGENT_ID=<agent-id>
AGENT_SECRET='<agent-secret>'

# --- Scopes -----------------------------------------------------------------------------------------------------
# organization_switch scope for the agent's own token in the user's organization (read-only tools).
AGENT_TRAVEL_POLICY_SCOPES=mcp:view_travel_policy
# Scopes in the delegated authorization URL (requested_actor=<AGENT_ID>) when a tool needs the user.
DELEGATED_BOOKING_SCOPES="mcp:create_booking mcp:view_travel_policy"
# Optional resource parameter for the delegated authorization request.
OBO_RESOURCE=
# Optional: scopes for the agent's own sign-in (only for an agent native to a sub-organization).
# AGENT_SIGN_IN_SCOPES=
# Optional: expected token issuer, if it differs from <ASGARDEO_BASE_URL>/oauth2/token.
# ASGARDEO_ISSUER=
# Send client_secret in the agent's authorize request (app-native authentication); false only to troubleshoot.
INCLUDE_CLIENT_SECRET_IN_AUTHORIZE=true

# --- LLM ----------------------------------------------------------------------------------------------------------
# gemini | openai | anthropic | deepseek | openai-compatible. This deployment: openai-compatible (WSO2 API Manager's
# AI gateway in front of Azure OpenAI gpt-5.2).
MODEL_PROVIDER=openai-compatible
MODEL_NAME=gpt-5.2
# Client-credentials application subscribed to the LLM API in API Manager. The token is cached until a minute
# before it expires and refreshed (and the call retried once) on a 401.
LLM_CLIENT_ID=<llm-client-id>
LLM_CLIENT_SECRET='<llm-client-secret>'
# Optional scope(s) for that token request.
LLM_TOKEN_SCOPE=
# Alternative to the client credentials: a static bearer key, used only when LLM_TOKEN_URL is empty.
# LLM_API_KEY=
# Keys for the other providers (only the one matching MODEL_PROVIDER is needed).
# GOOGLE_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# DEEPSEEK_API_KEY=

# --- Runtime ----------------------------------------------------------------------------------------------------
# debug | info | warn | error | fatal
LOG_LEVEL=info

# The WhatsApp transport (WHATSAPP_*) stays off unless WHATSAPP_PHONE_NUMBER_ID is set; not used here.
