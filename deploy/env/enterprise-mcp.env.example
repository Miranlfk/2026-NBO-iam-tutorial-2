# enterprise-mcp (MCP server, port 8001, internal only). Copy to enterprise-mcp.env.
# It needs no secrets: it verifies the bearer tokens the agent forwards and reads/writes the shared SQLite DB.
# One variable per line, no inline comments.

# --- Set by compose.yaml from ../.env (values here are ignored) -----------------------------------------------
# ASGARDEO_BASE_URL   tokens are verified against <ASGARDEO_BASE_URL>/oauth2/jwks   = ${ASGARDEO_BASE_URL}
# DB_PATH             SQLite file on the shared volume                               = /data/app.db

# --- Set by the image (override only if needed) ----------------------------------------------------------------
# HOST=0.0.0.0
# MCP_PORT=8001

# Admin role name; admins can list the whole organization's bookings (list_flight_bookings all=true).
NEXT_PUBLIC_ADMIN_ROLE_NAME=WayFinder-Admin

# Booking attribution for OBO bookings: name stored with the booking for the agent in act.sub.
AGENT_DISPLAY_NAME=WayFinder Assistant
# Optional map <agentId>=<Name>,...
AGENT_DISPLAY_NAMES=

# debug | info | warn | error | fatal
LOG_LEVEL=info
