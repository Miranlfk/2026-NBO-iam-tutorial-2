# enterprise-webapp (Next.js, port 3000). Copy to enterprise-webapp.env and fill in.
# Everything here is read at runtime; NEXT_PUBLIC_* values reach the browser through the server-rendered page,
# so never put a secret in one. One variable per line, no inline comments; single-quote values containing $.

# --- Set by compose.yaml from ../.env (values here are ignored) -----------------------------------------------
# NEXT_PUBLIC_BASE_URL            identity provider base URL            = ${ASGARDEO_BASE_URL}
# NEXT_PUBLIC_AFTER_SIGN_IN_URL   OIDC redirect_uri after sign-in       = https://enterprise.${APPS_DOMAIN}
# NEXT_PUBLIC_AFTER_SIGN_OUT_URL  post_logout_redirect_uri              = https://enterprise.${APPS_DOMAIN}
# NEXT_PUBLIC_AGENT_CHAT_URL      browser WebSocket to the AI agent     = wss://enterprise-agent.${APPS_DOMAIN}/chat
# DB_PATH                         SQLite file on the shared volume      = /data/app.db

# --- Root-organization application (Standard-Based, OIDC) -----------------------------------------------------
# Client ID: browser sign-in, server-side code exchange, and the M2M (client_credentials) calls below.
NEXT_PUBLIC_CLIENT_ID=<client-id>
# Client secret of the same application (server-side only).
CLIENT_SECRET='<client-secret>'
# Optional: a different client ID for the M2M calls (onboarding, branding, role sharing); it must share
# CLIENT_SECRET, so in practice leave it unset.
# CLIENT_ID=
# Application ID (UUID from the console URL): role sharing on tier upgrade (PATCH /api/server/v1/applications/share).
APP_ID=<application-uuid>
# Application name as shown in the console: role audience when sharing roles, and the shared app the
# enterprise IdP is added to in a sub-organization.
APP_DISPLAY_NAME=Wayfinder
# Root organization ID (UUID): parentId of the sub-organizations created at sign-up.
PARENT_ORGANIZATION_ID=<root-organization-uuid>

# --- Scopes ----------------------------------------------------------------------------------------------------
# Requested at user sign-in (authorization code).
NEXT_PUBLIC_SCOPES="openid profile email internal_org_user_mgt_create internal_org_user_mgt_update internal_org_user_mgt_list internal_org_role_mgt_users_update internal_org_role_mgt_view create_travel_policy view_travel_policy update_travel_policy delete_travel_policy internal_org_idp_create internal_org_idp_view internal_org_idp_update internal_org_idp_delete internal_org_application_mgt_view internal_org_application_mgt_update view_upgrade create_upgrade update_upgrade delete_upgrade internal_org_branding_preference_update create_basic_branding delete_branding create_advanced_branding create_booking view_booking delete_booking"
# Root client_credentials token used by sign-up (create the organization, wait for it).
ROOT_SCOPES="internal_organization_create internal_organization_view internal_org_user_mgt_create internal_org_user_mgt_list"
# organization_switch token into the new organization at sign-up (user store, first user, roles).
ORG_SCOPES="internal_org_user_mgt_create internal_org_user_mgt_list internal_org_userstore_view internal_org_role_mgt_view internal_org_role_mgt_update"
# Root client_credentials token for sharing tier roles with an organization (code default internal_application_mgt_update).
APP_SHARING_SCOPES=internal_shared_application_create

# --- Roles (application audience; names must match the console) -----------------------------------------------
NEXT_PUBLIC_ADMIN_ROLE_NAME=WayFinder-Admin
NEXT_PUBLIC_MEMBER_ROLE_NAME=WayFinder-Member
NEXT_PUBLIC_IDP_MANAGER_ROLE_NAME=IdP-Manager
NEXT_PUBLIC_BASIC_BRANDING_EDITOR_ROLE_NAME=Basic-Branding-Editor
NEXT_PUBLIC_ADVANCED_BRANDING_EDITOR_ROLE_NAME=Advanced-Branding-Editor

# --- Behaviour --------------------------------------------------------------------------------------------------
# true if "Enhanced organization authentication" is on for the application (then no fidp=OrganizationSSO).
NEXT_PUBLIC_ENHANCED_ORGANIZATION_AUTHENTICATION=false
# true to collect an organization handle at sign-up and send it as orgHandle.
NEXT_PUBLIC_ORGANIZATION_HANDLE_SUPPORTED=false
# User store for new users (userName <store>/<email>); sign-up waits for it in a new organization unless PRIMARY.
USER_STORE_NAME=DEFAULT
# Sign-up polling: interval, organization/user store readiness timeout, user creation retry timeout (ms).
POLL_INTERVAL_MS=1500
USERSTORE_TIMEOUT_MS=30000
USER_CREATION_RETRY_TIMEOUT_MS=30000
# Pause after a tier upgrade before asking the admin to sign in again (ms).
NEXT_PUBLIC_UPGRADE_WAIT_MS=5000
# Organizations (names or IDs, comma-separated) the chat widget is hidden from.
NEXT_PUBLIC_AGENT_CHAT_HIDDEN_ORGS=
# Optional: agent HTTP base for POST /obo/authorize-url (default: derived from NEXT_PUBLIC_AGENT_CHAT_URL).
# NEXT_PUBLIC_AGENT_HTTP_BASE_URL=
# Optional: host of the sub-organization commonauth callback written into enterprise IdPs
# (default: ${ASGARDEO_BASE_URL} without /t/<org>, giving https://<host>/o/<org-id>/commonauth).
# ASGARDEO_IDP_CALLBACK_BASE_URL=

# --- Agent attribution in the bookings UI -----------------------------------------------------------------------
# Name shown for bookings made by an AI agent (the OBO token's act.sub); or a map <agentId>=<Name>,...
AGENT_DISPLAY_NAME=WayFinder Assistant
AGENT_DISPLAY_NAMES=
# Badge accent per agent: <agentId>=green|violet,...
AGENT_DISPLAY_ACCENTS=

# --- Runtime ----------------------------------------------------------------------------------------------------
# debug | info | warn | error | fatal
LOG_LEVEL=info
# Seed the flight catalog on start (idempotent).
SEED_FLIGHTS=true
