# Compose-level settings for compose.yaml (copy to .env next to it). Every URL the services need is derived from
# these values; credentials and IDs go in env/<service>.env.
# Compose interpolates $ in unquoted and double-quoted values: single-quote anything that contains a literal $.

# Public apps domain. The services are served as enterprise.<APPS_DOMAIN> (webapp) and
# enterprise-agent.<APPS_DOMAIN> (AI agent), e.g. enterprise.20-1-2-3.sslip.io.
APPS_DOMAIN=20-1-2-3.sslip.io

# Identity provider (Asgardeo / Asgardeo local) organization base URL, no trailing slash. OAuth2/OIDC endpoints
# are <base>/oauth2/*, SCIM <base>/scim2/*, management APIs <base>/api/server/v1/*, sub-organization APIs
# <base>/o/*.
ASGARDEO_BASE_URL=https://api.example.com/t/<root-organization>

# LLM for the AI agent when MODEL_PROVIDER=openai-compatible (env/enterprise-agent.env): the chat-completions base
# URL (the client appends /chat/completions) and the OAuth2 token endpoint for its client-credentials token
# (default <ASGARDEO_BASE_URL>/oauth2/token).
LLM_BASE_URL=https://gateway.example.com/llm/1.0.0
# LLM_TOKEN_URL=https://api.example.com/t/<root-organization>/oauth2/token

# Host ports, bound to 127.0.0.1 only (for a proxy on the host, or curl). The MCP server publishes none.
ENTERPRISE_WEBAPP_PORT=3100
ENTERPRISE_AGENT_PORT=8791

# Image names: <ENTERPRISE_IMAGE_REPO>-webapp|-mcp|-agent:<ENTERPRISE_IMAGE_TAG>.
ENTERPRISE_IMAGE_REPO=wayfinder-enterprise
ENTERPRISE_IMAGE_TAG=latest

# Docker network the services share; a Caddy container can join it to reach them by service name.
ENTERPRISE_NETWORK=wayfinder-enterprise
