# Port used by the MCP server.
MCP_PORT=8001

# Host used by the MCP server (0.0.0.0 in a container).
HOST=localhost

# Base URL of your Asgardeo / WSO2 Identity Server organization. The server verifies
# access tokens against <ASGARDEO_BASE_URL>/oauth2/jwks.
# ASGARDEO_BASE_URL=https://api.asgardeo.io/t/<your-organization-name>

# SQLite database shared with the webapp (defaults to ../webapp/data/app.db).
# DB_PATH=/var/data/app.db

# The MCP server calls the B2B app's service functions directly (DB queries) instead
# of going over REST. Everything comes from the environment; for local development,
# values missing there are filled from this file and then ../webapp/.env.local
# (where the base URL is NEXT_PUBLIC_BASE_URL, also accepted here).

# Role names, only needed if they differ from the defaults; the admin role lets
# list_flight_bookings return the whole organization's bookings.
# NEXT_PUBLIC_ADMIN_ROLE_NAME=WayFinder-Admin

# Display name(s) for AI agents that book on a user's behalf, used to attribute
# bookings made through the OBO flow.
# AGENT_DISPLAY_NAME=WayFinder Assistant
# AGENT_DISPLAY_NAMES=<agentId>=<Name>,<agentId>=<Name>
# AGENT_DISPLAY_ACCENTS=<agentId>=green,<agentId>=violet

# debug | info | warn | error | fatal
# LOG_LEVEL=info
